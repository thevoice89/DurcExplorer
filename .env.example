# =====================================================================
# PANNELLO DI CONFIGURAZIONE — PDND DURC Batch
# Copiare in `.env` (oppure: python -m durc_batch.doctor --init) e compilare.
# Prefisso obbligatorio: PDND_  (gestito da pydantic-settings)
# NON committare mai il file .env reale.
# Verifica in ogni momento con:  python -m durc_batch.doctor
# =====================================================================

# --- Identità client PDND (DA COMPILARE) ---
# client_id: UUID del client, ottenuto registrando il client sul portale PDND.
PDND_CLIENT_ID=
# kid: Key ID restituito dalla PDND dopo aver caricato la chiave PUBBLICA.
PDND_KID=
# Percorso della chiave PRIVATA RSA (default ok: basta posizionare il file).
# Per generarla:  python -m durc_batch.doctor --gen-key
PDND_PRIVATE_KEY_PATH=keys/private_key.pem

# --- Endpoint PDND (default = PRODUZIONE; per il collaudo usare gli URL UAT) ---
# token_endpoint = dove si fa la POST per ottenere il voucher
# auth_audience  = valore del claim `aud` della client assertion
PDND_TOKEN_ENDPOINT=https://auth.interop.pagopa.it/token.oauth2
PDND_AUTH_AUDIENCE=auth.interop.pagopa.it/client-assertion

# --- E-service DURC (DA COMPILARE: specifici dell'e-service sul catalogo) ---
# Reperibili dalla scheda dell'e-service e dalla finalità (purpose) approvata.
PDND_DURC_BASE_URL=
PDND_DURC_PURPOSE_ID=
PDND_DURC_AUDIENCE=

# --- Parametri operativi (default sensati: modificare solo se necessario) ---
PDND_RATE_LIMIT_PER_SECOND=5.0
PDND_RATE_LIMIT_BURST=10
PDND_ASSERTION_TTL_SECONDS=600
PDND_MAX_RETRIES=5
PDND_POLL_INTERVAL_SECONDS=60
PDND_POLL_MAX_ATTEMPTS=20

# --- I/O e logging ---
PDND_INPUT_CSV=data/input/codici_fiscali.csv
PDND_OUTPUT_DIR=data/output
PDND_LOG_DIR=logs
PDND_LOG_LEVEL=INFO
PDND_STATE_DB_URL=sqlite:///data/state.db
